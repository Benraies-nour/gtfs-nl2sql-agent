# Active provider: "openai" or "groq"
LLM_PROVIDER=groq

GROQ_API_KEY=
OPENAI_API_KEY=

# Models: picked automatically from the provider (see soretrak/config.py).
#   openai: gpt-4.1-mini (Router and agent)
#   groq:   openai/gpt-oss-20b (Router), qwen/qwen3.8-27b (agent)
# Uncomment only to force another model of the active provider.
# LLM_MODEL_ROUTER=
# LLM_MODEL_AGENT=

